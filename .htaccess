<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Nếu yêu cầu đã vào thư mục public/ thì dừng ngay, tránh lặp vô tận (500 error)
    RewriteRule ^public/ - [L]

    # 2. Nếu là tệp hoặc thư mục thật tồn tại thì chạy trực tiếp (như diag.php, test.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # 3. Định tuyến tất cả vào thư mục /public
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
